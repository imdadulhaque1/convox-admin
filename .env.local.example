# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# The ConvoX backend's REST base URL (see connectx_api's ApiConstants / API_INTEGRATION.md).
# No trailing slash. Everything is proxied server-side through this app's own /api/* routes,
# so this value is never sent to the browser.
BACKEND_BASE_URL=http://40.81.26.50/api

# Same host, used to resolve relative avatar/media paths ("/uploads/avatars/x.jpg"). Also
# server-only — proxied through /api/media/** (see that route + lib/media.ts) so the
# browser never sees this host either, same as every JSON call.
BACKEND_MEDIA_URL=http://40.81.26.50

# Set to "true" once the backend is served over HTTPS with a real certificate, so the
# session cookies can be marked Secure. Leave "false" while it's still the bare-IP HTTP
# backend, or browsers will refuse to send the cookies at all.
COOKIES_SECURE=false
